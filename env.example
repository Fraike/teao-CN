# 数据库(默认本地文件)
DATABASE_URL=file:data/teao-cn.db

# 后台登录
AUTH_SECRET=请替换为随机长字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码
# 仅在 HTTPS 尚未配置、需要用 http 访问后台时临时设为 false;上线 HTTPS 后删除此行
# AUTH_COOKIE_SECURE=false

# 询盘通知(可选;企业微信群机器人填 wecom)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TYPE=generic

# 百度主动推送(可选,从百度搜索资源平台「普通收录 → API 提交」获取)
BAIDU_PUSH_TOKEN=
